# Black Box engine — environment template. Copy to .env and fill in. NEVER commit real values.

# --- Reasoning layer (optional). Engine runs fully deterministically without this. ---
# ANTHROPIC_API_KEY=sk-ant-...
# BLACKBOX_MODEL=claude-opus-4-8

# --- Project selection (optional; or pass --project on the CLI) ---
# BLACKBOX_PROJECT=casa-escondida

# --- Odoo connection (Tier 2 / API). Leave unset for --dry-run. ---
# ODOO_URL=https://your-instance.odoo.com
# ODOO_DB=your-db
# ODOO_LOGIN=your-login
# ODOO_API_KEY=__rotate_me__

# --- Odoo.sh SSH (Tier 1, optional) ---
# ODOO_SH_HOST=your-project.odoo.com

# Reminder: rotate ODOO_API_KEY / ANTHROPIC_API_KEY regularly and after any exposure.
