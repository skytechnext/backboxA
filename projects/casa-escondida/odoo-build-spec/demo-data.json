{
  "$schema": "internal://casa-escondida/odoo19-build/demo-data",
  "version": "2.0",
  "objective": "Populate Odoo 19 extensively so the system looks alive and demoable. Window 2025-12-01..2026-05-31.",
  "instance": "edu-escondida.odoo.com",
  "currency": "PHP",
  "rooms_total": 23,
  "room_breakdown": {"Standard": 15, "Deluxe": 2, "White Beach Deluxe": 2, "Suite": 4},
  "tolerance_pct": 10,
  "default_code_prefixes": ["DIVE", "COURSE", "GEAR", "CONS", "FNB", "RETAIL"],
  "personas": ["macro_photographer_intl", "domestic_weekend_diver", "course_student", "dive_club_member", "non_diving_partner"],
  "required_automations": ["Dynamic seasonal pricing", "Overbooking guard", "Post-stay review request"],
  "entities": [
    {"stage": 2, "key": "chart_of_accounts", "model": "account.account", "target": 60, "key_field": "code",
     "vals": {"code": "ACC{i:03d}", "name": "Account {i}"}},
    {"stage": 2, "key": "currencies", "model": "res.currency", "target": 3, "key_field": "name",
     "vals": {"name": "CUR{i}"}},
    {"stage": 2, "key": "sales_vat_12", "model": "account.tax", "target": 1, "key_field": "name",
     "domain": [["type_tax_use", "=", "sale"], ["amount", "=", 12]],
     "vals": {"name": "TAX-S12", "amount": 12, "type_tax_use": "sale"}},
    {"stage": 2, "key": "purchase_vat_12", "model": "account.tax", "target": 1, "key_field": "name",
     "domain": [["type_tax_use", "=", "purchase"]],
     "vals": {"name": "TAX-P12", "amount": 12, "type_tax_use": "purchase"}},
    {"stage": 2, "key": "other_taxes", "model": "account.tax", "target": 2, "key_field": "name",
     "domain": [["kind", "=", "other"]],
     "vals": {"name": "TAX-OTHER-{i}", "amount": 0, "kind": "other"}},
    {"stage": 2, "key": "journals", "model": "account.journal", "target": 6, "key_field": "name",
     "vals": {"name": "Journal {i}"}},
    {"stage": 2, "key": "pricelists", "model": "product.pricelist", "target": 2, "key_field": "name",
     "vals": {"name": "PL-{i}"}},

    {"stage": 3, "key": "persona_tags", "model": "res.partner.category", "target": 5, "key_field": "name",
     "vals": {"name": "Persona {i}"}},
    {"stage": 3, "key": "customers", "model": "res.partner", "target": 150, "key_field": "email",
     "domain": [["customer_rank", ">", 0]],
     "vals": {"name": "Customer {i}", "email": "cust{i}@casa.example", "customer_rank": 1}},
    {"stage": 3, "key": "ota_partners", "model": "res.partner", "target": 3, "key_field": "name",
     "domain": [["partner_kind", "=", "ota"]], "vals": {"name": "OTA {i}", "partner_kind": "ota"}},
    {"stage": 3, "key": "agents", "model": "res.partner", "target": 8, "key_field": "name",
     "domain": [["partner_kind", "=", "agent"]], "vals": {"name": "Agent {i}", "partner_kind": "agent"}},
    {"stage": 3, "key": "vendors", "model": "res.partner", "target": 20, "key_field": "email",
     "domain": [["supplier_rank", ">", 0]],
     "vals": {"name": "Vendor {i}", "email": "vend{i}@casa.example", "supplier_rank": 1}},
    {"stage": 3, "key": "departments", "model": "hr.department", "target": 8, "key_field": "name",
     "vals": {"name": "Department {i}"}},
    {"stage": 3, "key": "employees", "model": "hr.employee", "target": 36, "key_field": "name",
     "vals": {"name": "Employee {i}"}},
    {"stage": 3, "key": "dive_sites", "model": "dive.site", "target": 35, "key_field": "name",
     "vals": {"name": "Dive Site {i}"}},
    {"stage": 3, "key": "resources", "model": "calendar.resource", "target": 10, "key_field": "name",
     "vals": {"name": "Resource {i}"}},

    {"stage": 4, "key": "rooms_standard", "model": "product.room", "target": 15, "key_field": "default_code",
     "domain": [["room_type", "=", "Standard"]],
     "vals": {"name": "Standard {i}", "default_code": "STD-{i:02d}", "room_type": "Standard"}},
    {"stage": 4, "key": "rooms_deluxe", "model": "product.room", "target": 2, "key_field": "default_code",
     "domain": [["room_type", "=", "Deluxe"]],
     "vals": {"name": "Deluxe {i}", "default_code": "DLX-{i:02d}", "room_type": "Deluxe"}},
    {"stage": 4, "key": "rooms_white_beach", "model": "product.room", "target": 2, "key_field": "default_code",
     "domain": [["room_type", "=", "White Beach Deluxe"]],
     "vals": {"name": "White Beach Deluxe {i}", "default_code": "WBD-{i:02d}", "room_type": "White Beach Deluxe"}},
    {"stage": 4, "key": "rooms_suite", "model": "product.room", "target": 4, "key_field": "default_code",
     "domain": [["room_type", "=", "Suite"]],
     "vals": {"name": "Suite {i}", "default_code": "SVS-{i:02d}", "room_type": "Suite"}},
    {"stage": 4, "key": "dive_products", "model": "product.product", "target": 6, "key_field": "default_code",
     "domain": [["category", "=", "dive"]],
     "vals": {"name": "Dive Trip {i}", "default_code": "DIVE-{i:02d}", "category": "dive"}},
    {"stage": 4, "key": "course_products", "model": "product.product", "target": 7, "key_field": "default_code",
     "domain": [["category", "=", "course"]],
     "vals": {"name": "Course {i}", "default_code": "COURSE-{i:02d}", "category": "course"}},
    {"stage": 4, "key": "gear_products", "model": "product.product", "target": 12, "key_field": "default_code",
     "domain": [["category", "=", "gear"]],
     "vals": {"name": "Gear {i}", "default_code": "GEAR-{i:02d}", "category": "gear"}},
    {"stage": 4, "key": "consumables", "model": "product.product", "target": 8, "key_field": "default_code",
     "domain": [["category", "=", "cons"]],
     "vals": {"name": "Consumable {i}", "default_code": "CONS-{i:02d}", "category": "cons"}},
    {"stage": 4, "key": "fnb_products", "model": "product.product", "target": 60, "key_field": "default_code",
     "domain": [["category", "=", "fnb"]],
     "vals": {"name": "F&B Item {i}", "default_code": "FNB-{i:03d}", "category": "fnb"}},
    {"stage": 4, "key": "retail_products", "model": "product.product", "target": 40, "key_field": "default_code",
     "domain": [["category", "=", "retail"]],
     "vals": {"name": "Retail Item {i}", "default_code": "RETAIL-{i:03d}", "category": "retail"}},

    {"stage": 5, "key": "pos_configs", "model": "pos.config", "target": 2, "key_field": "name",
     "vals": {"name": "POS {i}"}},
    {"stage": 5, "key": "payment_methods", "model": "pos.payment.method", "target": 3, "key_field": "name",
     "domain": [["kind", "=", "standard"]], "vals": {"name": "Payment Method {i}", "kind": "standard"}},
    {"stage": 5, "key": "room_charge_method", "model": "pos.payment.method", "target": 1, "key_field": "name",
     "domain": [["name", "=", "Room Charge"]], "vals": {"name": "Room Charge"}},
    {"stage": 5, "key": "appointment_types", "model": "appointment.type", "target": 4, "key_field": "name",
     "vals": {"name": "Appointment Type {i}"}},

    {"stage": 6, "key": "room_reservations", "model": "sale.order", "target": 200, "key_field": "client_order_ref",
     "domain": [["order_kind", "=", "room"]],
     "vals": {"client_order_ref": "CE-ROOM-{i:05d}", "order_kind": "room", "state": "draft"}},
    {"stage": 6, "key": "dive_bookings", "model": "sale.order", "target": 300, "key_field": "client_order_ref",
     "domain": [["order_kind", "=", "dive"]],
     "vals": {"client_order_ref": "CE-DIVE-{i:05d}", "order_kind": "dive", "state": "draft"}},
    {"stage": 6, "key": "gear_rentals", "model": "sale.order", "target": 150, "key_field": "client_order_ref",
     "domain": [["order_kind", "=", "gear"]],
     "vals": {"client_order_ref": "CE-GEAR-{i:05d}", "order_kind": "gear", "state": "draft"}},
    {"stage": 6, "key": "course_cohorts", "model": "event.event", "target": 40, "key_field": "name",
     "vals": {"name": "Cohort {i}"}},
    {"stage": 6, "key": "pos_orders", "model": "pos.order", "target": 2000, "key_field": "pos_reference",
     "vals": {"pos_reference": "POS-{i:05d}"}},
    {"stage": 6, "key": "crm_leads", "model": "crm.lead", "target": 80, "key_field": "name",
     "domain": [["type", "=", "lead"]], "vals": {"name": "Lead {i}", "type": "lead"}},
    {"stage": 6, "key": "crm_opportunities", "model": "crm.lead", "target": 50, "key_field": "name",
     "domain": [["type", "=", "opportunity"]], "vals": {"name": "Opportunity {i}", "type": "opportunity"}},

    {"stage": 7, "key": "customer_invoices", "model": "account.move", "target": 400, "key_field": "ref",
     "domain": [["move_type", "=", "out_invoice"], ["state", "=", "posted"]],
     "vals": {"ref": "INV-{i:05d}", "move_type": "out_invoice", "state": "posted"}},
    {"stage": 7, "key": "vendor_bills", "model": "account.move", "target": 120, "key_field": "ref",
     "domain": [["move_type", "=", "in_invoice"], ["state", "=", "posted"]],
     "vals": {"ref": "BILL-{i:05d}", "move_type": "in_invoice", "state": "posted"}},
    {"stage": 7, "key": "payments", "model": "account.payment", "target": 416, "key_field": "ref",
     "vals": {"ref": "PAY-{i:05d}"}},
    {"stage": 7, "key": "certifications", "model": "documents.document", "target": 35, "key_field": "name",
     "domain": [["kind", "=", "certification"]], "vals": {"name": "Cert {i}", "kind": "certification"}},
    {"stage": 7, "key": "maintenance_requests", "model": "maintenance.request", "target": 40, "key_field": "name",
     "vals": {"name": "Maintenance {i}"}},

    {"stage": 8, "key": "automations", "model": "ir.cron", "target": 12, "key_field": "name",
     "domain": [["kind", "=", "native"]], "vals": {"name": "Automation {i}", "kind": "native"}}
  ]
}
